import QseriesFormalization.Basic
import QseriesFormalization.Chapter01

/-!
# Chapter 16 — Part IV: Proofs of the 'Most Beautiful Identity'

(Hei-Chi Chan, *An Invitation to q-Series*, Ch 16, pp. 147-156.)

⚠️  **SHADOW CHAPTER**.

Per `PLAYBOOK_AUDIT.md` (2026-05-22): this file currently contains ~5,057
declarations, of which roughly 4,900 are mechanical `mbiRHSDenominatorTrunc_N`
/ `mbiRHSNumeratorTrunc_N` / `mbiLHSTrunc_N` closed-form unfoldings extending
to `_hundredandsixteen`.  Chan's "Most Beautiful Identity" itself,

    ∑_{n=0}^∞ p(5n+4) q^n  =  5 · (q^5;q^5)_∞^5 / (q;q)_∞^6  ,

is **not** stated as a theorem in this repository — neither as a formal
power series identity nor as an analytic identity for `‖q‖ < 1`.

Until Chan's MBI is added as a real theorem (with proof, or with `sorry`
honestly tagged), this file is auxiliary scaffolding.
-/

namespace QseriesFormalization
namespace PartIV
namespace Ch16

section CommRing

variable {R : Type*} [CommRing R]

/-- Truncated LHS: `∑_{n=0}^N p(5n+4) q^n`. Uses `partitionCount` from Ch 1. -/
def mbiLHSTrunc (q : R) (N : Nat) : R :=
  natSum (fun n => (Ch01.partitionCount (5 * n + 4) : R) * q ^ n) N

theorem mbiLHSTrunc_one (q : R) :
    mbiLHSTrunc q 1 =
      (Ch01.partitionCount 4 : R) + (Ch01.partitionCount 9 : R) * q := by
  rw [mbiLHSTrunc, natSum_succ, natSum_zero]
  change (Ch01.partitionCount 4 : R) * q ^ 0 +
      (Ch01.partitionCount 9 : R) * q ^ 1 =
    (Ch01.partitionCount 4 : R) + (Ch01.partitionCount 9 : R) * q
  rw [pow_zero, pow_one, mul_one]

/--
`N = 2` expansion of the truncated LHS. The `q^2` coefficient is left as
`partitionCount 14` until the explicit value `p(14) = 135` is available in
Chapter 1.
-/
theorem mbiLHSTrunc_two (q : R) :
    mbiLHSTrunc q 2 =
      (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 := by
  rw [mbiLHSTrunc, natSum_succ, natSum_succ, natSum_zero]
  change (Ch01.partitionCount 4 : R) * q ^ 0 +
      (Ch01.partitionCount 9 : R) * q ^ 1 +
      (Ch01.partitionCount 14 : R) * q ^ 2 =
    (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2
  rw [pow_zero, pow_one, mul_one, Ch01.partitionCount_four, Ch01.partitionCount_nine]
  simp only [Nat.cast_ofNat]

theorem mbiLHSTrunc_three (q : R) :
    mbiLHSTrunc q 3 =
      (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 +
        (Ch01.partitionCount 19 : R) * q ^ 3 := by
  rw [mbiLHSTrunc, natSum_succ, natSum_succ, natSum_succ, natSum_zero]
  change (Ch01.partitionCount 4 : R) * q ^ 0 +
      (Ch01.partitionCount 9 : R) * q ^ 1 +
      (Ch01.partitionCount 14 : R) * q ^ 2 +
      (Ch01.partitionCount 19 : R) * q ^ 3 =
    (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 +
      (Ch01.partitionCount 19 : R) * q ^ 3
  rw [pow_zero, pow_one, mul_one, Ch01.partitionCount_four, Ch01.partitionCount_nine]
  simp only [Nat.cast_ofNat]

theorem mbiLHSTrunc_four (q : R) :
    mbiLHSTrunc q 4 =
      (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 +
        (Ch01.partitionCount 19 : R) * q ^ 3 +
        (Ch01.partitionCount 24 : R) * q ^ 4 := by
  rw [mbiLHSTrunc, natSum_succ, natSum_succ, natSum_succ, natSum_succ, natSum_zero]
  change (Ch01.partitionCount 4 : R) * q ^ 0 +
      (Ch01.partitionCount 9 : R) * q ^ 1 +
      (Ch01.partitionCount 14 : R) * q ^ 2 +
      (Ch01.partitionCount 19 : R) * q ^ 3 +
      (Ch01.partitionCount 24 : R) * q ^ 4 =
    (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 +
      (Ch01.partitionCount 19 : R) * q ^ 3 +
      (Ch01.partitionCount 24 : R) * q ^ 4
  rw [pow_zero, pow_one, mul_one, Ch01.partitionCount_four, Ch01.partitionCount_nine]
  simp only [Nat.cast_ofNat]

end CommRing

section Field

variable {R : Type*} [Field R]

/-- Truncated RHS numerator: `∏_{n=1}^N (1 - q^{5n})^5`. -/
noncomputable def mbiRHSNumeratorTrunc (q : R) (N : Nat) : R :=
  match N with
  | 0 => 1
  | Nat.succ n =>
      mbiRHSNumeratorTrunc q n * (1 - q ^ (5 * (n + 1))) ^ 5

/-- Recursion wrapper for `mbiRHSNumeratorTrunc`. -/
theorem mbiRHSNumeratorTrunc_succ (q : R) (n : Nat) :
    mbiRHSNumeratorTrunc q (n + 1) =
      mbiRHSNumeratorTrunc q n * (1 - q ^ (5 * (n + 1))) ^ 5 := rfl

theorem mbiRHSNumeratorTrunc_one (q : R) :
    mbiRHSNumeratorTrunc q 1 = (1 - q ^ 5) ^ 5 := by
  change (1 : R) * (1 - q ^ 5) ^ 5 = (1 - q ^ 5) ^ 5
  rw [one_mul]

theorem mbiRHSNumeratorTrunc_two (q : R) :
    mbiRHSNumeratorTrunc q 2 = (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 := by
  change mbiRHSNumeratorTrunc q 1 * (1 - q ^ (5 * (1 + 1))) ^ 5 =
    (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5
  rw [mbiRHSNumeratorTrunc_one]

theorem mbiRHSNumeratorTrunc_three (q : R) :
    mbiRHSNumeratorTrunc q 3 =
      (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5 := by
  change mbiRHSNumeratorTrunc q 2 * (1 - q ^ (5 * (2 + 1))) ^ 5 =
    (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5
  rw [mbiRHSNumeratorTrunc_two]

theorem mbiRHSNumeratorTrunc_four (q : R) :
    mbiRHSNumeratorTrunc q 4 =
      (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5 * (1 - q ^ 20) ^ 5 := by
  change mbiRHSNumeratorTrunc q 3 * (1 - q ^ (5 * (3 + 1))) ^ 5 =
    (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5 * (1 - q ^ 20) ^ 5
  rw [mbiRHSNumeratorTrunc_three]

/-- mbiRHSNumeratorTrunc at N=5. -/
theorem mbiRHSNumeratorTrunc_five (q : R) :
    mbiRHSNumeratorTrunc q 5 =
      (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5 *
      (1 - q ^ 20) ^ 5 * (1 - q ^ 25) ^ 5 := by
  simp [mbiRHSNumeratorTrunc]

/-- Truncated RHS denominator: `∏_{n=1}^N (1 - q^n)^6`. -/
noncomputable def mbiRHSDenominatorTrunc (q : R) (N : Nat) : R :=
  match N with
  | 0 => 1
  | Nat.succ n =>
      mbiRHSDenominatorTrunc q n * (1 - q ^ (n + 1)) ^ 6

/-- Recursion wrapper for `mbiRHSDenominatorTrunc`. -/
theorem mbiRHSDenominatorTrunc_succ (q : R) (n : Nat) :
    mbiRHSDenominatorTrunc q (n + 1) =
      mbiRHSDenominatorTrunc q n * (1 - q ^ (n + 1)) ^ 6 := rfl

theorem mbiRHSDenominatorTrunc_one (q : R) :
    mbiRHSDenominatorTrunc q 1 = (1 - q) ^ 6 := by
  change (1 : R) * (1 - q ^ 1) ^ 6 = (1 - q) ^ 6
  rw [pow_one, one_mul]

theorem mbiRHSDenominatorTrunc_two (q : R) :
    mbiRHSDenominatorTrunc q 2 = (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 := by
  change mbiRHSDenominatorTrunc q 1 * (1 - q ^ (1 + 1)) ^ 6 =
    (1 - q) ^ 6 * (1 - q ^ 2) ^ 6
  rw [mbiRHSDenominatorTrunc_one]

theorem mbiRHSDenominatorTrunc_three (q : R) :
    mbiRHSDenominatorTrunc q 3 =
      (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6 := by
  change mbiRHSDenominatorTrunc q 2 * (1 - q ^ (2 + 1)) ^ 6 =
    (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6
  rw [mbiRHSDenominatorTrunc_two]

theorem mbiRHSDenominatorTrunc_four (q : R) :
    mbiRHSDenominatorTrunc q 4 =
      (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6 * (1 - q ^ 4) ^ 6 := by
  change mbiRHSDenominatorTrunc q 3 * (1 - q ^ (3 + 1)) ^ 6 =
    (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6 * (1 - q ^ 4) ^ 6
  rw [mbiRHSDenominatorTrunc_three]

theorem mbiRHSDenominatorTrunc_five (q : R) :
    mbiRHSDenominatorTrunc q 5 =
      (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6 *
      (1 - q ^ 4) ^ 6 * (1 - q ^ 5) ^ 6 := by
  change mbiRHSDenominatorTrunc q 4 * (1 - q ^ (4 + 1)) ^ 6 = _
  rw [mbiRHSDenominatorTrunc_four]

theorem mbiRHSNumeratorTrunc_six (q : R) :
    mbiRHSNumeratorTrunc q 6 =
      (1 - q ^ 5) ^ 5 * (1 - q ^ 10) ^ 5 * (1 - q ^ 15) ^ 5 *
      (1 - q ^ 20) ^ 5 * (1 - q ^ 25) ^ 5 * (1 - q ^ 30) ^ 5 := by
  simp [mbiRHSNumeratorTrunc]

theorem mbiRHSDenominatorTrunc_six (q : R) :
    mbiRHSDenominatorTrunc q 6 =
      (1 - q) ^ 6 * (1 - q ^ 2) ^ 6 * (1 - q ^ 3) ^ 6 *
