  change mbiRHSDenominatorTrunc q 5 * (1 - q ^ (5 + 1)) ^ 6 = _
  rw [mbiRHSDenominatorTrunc_five]

/-- Truncated RHS:
`5 · ∏_{n=1}^N (1 - q^{5n})^5 / ∏_{n=1}^N (1 - q^n)^6`. -/
noncomputable def mbiRHSTrunc (q : R) (N : Nat) : R :=
  5 * mbiRHSNumeratorTrunc q N / mbiRHSDenominatorTrunc q N

theorem mbi_truncated_zero {R : Type*} [Field R] (q : R) :
    mbiLHSTrunc q 0 = (Ch01.partitionCount 4 : R) ∧
    mbiRHSTrunc q 0 = 5 := by
  constructor
  · simp [mbiLHSTrunc]
  · simp [mbiRHSTrunc, mbiRHSNumeratorTrunc, mbiRHSDenominatorTrunc]

