variable {R : Type*} [Field R]

/-- Truncated LHS of Chan Ch 13 identity: `sum_{k=0}^N q^{k^2} / (q;q)_k^2`. -/
noncomputable def deepIdentityLHSTrunc (q : R) (N : Nat) : R :=
  natSum (fun k => q ^ (k * k) / (qPochhammer q k) ^ 2) N

/-- N=0 sanity: the 0-truncation is 1. -/
@[simp] theorem deepIdentityLHSTrunc_zero (q : R) :
    deepIdentityLHSTrunc q 0 = 1 := by
  simp [deepIdentityLHSTrunc, natSum, qPochhammer]

/-- Recursion: `deepIdentityLHSTrunc q (N+1) = deepIdentityLHSTrunc q N + q^((N+1)²) / (q;q)_(N+1)²`.
Not marked `@[simp]` because doing so makes downstream `simp` calls in the
case-by-case `_N` closed-form theorems recurse exponentially. -/
theorem deepIdentityLHSTrunc_succ (q : R) (N : Nat) :
    deepIdentityLHSTrunc q (N + 1) =
      deepIdentityLHSTrunc q N +
        q ^ ((N + 1) * (N + 1)) / (qPochhammer q (N + 1)) ^ 2 := by
  simp [deepIdentityLHSTrunc]

/-- N=1: `1 + q / (1 - q)^2`. -/
theorem deepIdentityLHSTrunc_one (q : R) :
    deepIdentityLHSTrunc q 1 = 1 + q / (1 - q) ^ 2 := by
  simp [deepIdentityLHSTrunc, natSum, qPochhammer]

/-- N=2: `1 + q/(1-q)^2 + q^4/((1-q)*(1-q^2))^2`. -/
theorem deepIdentityLHSTrunc_two (q : R) :
    deepIdentityLHSTrunc q 2 =
      1 + q / (1 - q) ^ 2 +
      q ^ 4 / ((1 - q) * (1 - q ^ 2)) ^ 2 := by
  simp [deepIdentityLHSTrunc, natSum, qPochhammer]

