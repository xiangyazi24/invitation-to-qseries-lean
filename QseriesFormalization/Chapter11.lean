/-- The Golden Ratio `(1 + √5) / 2`. -/
noncomputable def α : ℝ := (1 + Real.sqrt 5) / 2

/-- The negative reciprocal `(1 - √5) / 2`. -/
noncomputable def β : ℝ := (1 - Real.sqrt 5) / 2

/-- Sanity: `α + β = 1`. -/
theorem α_add_β : α + β = 1 := by
  unfold α β
  ring

/-- Sanity: `α · β = -1`. -/
theorem α_mul_β : α * β = -1 := by
  unfold α β
  have hs : (Real.sqrt 5) ^ 2 = (5 : ℝ) := Real.sq_sqrt (by norm_num)
  nlinarith

/-- Sanity: `α² = α + 1` (golden ratio identity). -/
theorem α_sq : α ^ 2 = α + 1 := by
  unfold α
  have hs : (Real.sqrt 5) ^ 2 = (5 : ℝ) := Real.sq_sqrt (by norm_num)
  nlinarith

/-- Sanity: `β² = β + 1` (the conjugate golden ratio identity). -/
theorem β_sq : β ^ 2 = β + 1 := by
  unfold β
  have hs : (Real.sqrt 5) ^ 2 = (5 : ℝ) := Real.sq_sqrt (by norm_num)
  nlinarith

/-- Sanity: `α³ = 2α + 1`. -/
theorem α_cubed : α ^ 3 = 2 * α + 1 := by
  calc
    α ^ 3 = α * α ^ 2 := by ring
    _ = α * (α + 1) := by rw [α_sq]
    _ = 2 * α + 1 := by nlinarith [α_sq]

/-- Sanity: `β³ = 2β + 1`. -/
theorem β_cubed : β ^ 3 = 2 * β + 1 := by
  calc
    β ^ 3 = β * β ^ 2 := by ring
    _ = β * (β + 1) := by rw [β_sq]
    _ = 2 * β + 1 := by nlinarith [β_sq]

/-- Sanity: `α⁻¹ = α - 1`. -/
theorem α_inv : α⁻¹ = α - 1 := by
  have hα : α ≠ 0 := by
    intro h
    have hmul := α_mul_β
    rw [h, zero_mul] at hmul
    norm_num at hmul
  field_simp [hα]
  nlinarith [α_sq]

/-- Sanity: `β⁻¹ = β - 1`. -/
theorem β_inv : β⁻¹ = β - 1 := by
  have hβ : β ≠ 0 := by
    intro h
    have hmul := α_mul_β
    rw [h, mul_zero] at hmul
    norm_num at hmul
  field_simp [hβ]
  nlinarith [β_sq]

/-- α^n satisfies Fibonacci-like recurrence α^{n+2} = α^{n+1} + α^n. -/
theorem α_recurrence (n : Nat) :
    α ^ (n + 2) = α ^ (n + 1) + α ^ n := by
  calc
    α ^ (n + 2) = α ^ n * α ^ 2 := by rw [pow_add]
    _ = α ^ n * (α + 1) := by rw [α_sq]
    _ = α ^ (n + 1) + α ^ n := by
      rw [pow_succ]
      ring

/-- β^n satisfies Fibonacci-like recurrence β^{n+2} = β^{n+1} + β^n. -/
theorem β_recurrence (n : Nat) :
    β ^ (n + 2) = β ^ (n + 1) + β ^ n := by
  calc
    β ^ (n + 2) = β ^ n * β ^ 2 := by rw [pow_add]
    _ = β ^ n * (β + 1) := by rw [β_sq]
    _ = β ^ (n + 1) + β ^ n := by
      rw [pow_succ]
      ring

/-- Sanity: `α⁴ = 3α + 2`. -/
theorem α_pow_four : α ^ 4 = 3 * α + 2 := by
  calc
    α ^ 4 = α ^ 3 + α ^ 2 := by simpa using α_recurrence 2
    _ = 3 * α + 2 := by nlinarith [α_cubed, α_sq]

/-- Sanity: `α⁵ = 5α + 3`. -/
theorem α_pow_five : α ^ 5 = 5 * α + 3 := by
  calc
    α ^ 5 = α ^ 4 + α ^ 3 := by simpa using α_recurrence 3
    _ = 5 * α + 3 := by nlinarith [α_pow_four, α_cubed]

theorem α_pow_six : α ^ 6 = 8 * α + 5 := by
  calc
    α ^ 6 = α ^ 5 + α ^ 4 := by simpa using α_recurrence 4
    _ = 8 * α + 5 := by nlinarith [α_pow_five, α_pow_four]

theorem β_pow_four : β ^ 4 = 3 * β + 2 := by
  calc
    β ^ 4 = β ^ 3 + β ^ 2 := by simpa using β_recurrence 2
    _ = 3 * β + 2 := by nlinarith [β_cubed, β_sq]

theorem β_pow_five : β ^ 5 = 5 * β + 3 := by
  calc
    β ^ 5 = β ^ 4 + β ^ 3 := by simpa using β_recurrence 3
    _ = 5 * β + 3 := by nlinarith [β_pow_four, β_cubed]

theorem α_pow_seven : α ^ 7 = 13 * α + 8 := by
  calc
    α ^ 7 = α ^ 6 + α ^ 5 := by simpa using α_recurrence 5
    _ = 13 * α + 8 := by nlinarith [α_pow_six, α_pow_five]

theorem β_pow_six : β ^ 6 = 8 * β + 5 := by
  calc
    β ^ 6 = β ^ 5 + β ^ 4 := by simpa using β_recurrence 4
    _ = 8 * β + 5 := by nlinarith [β_pow_five, β_pow_four]

theorem α_pow_eight : α ^ 8 = 21 * α + 13 := by
  calc
    α ^ 8 = α ^ 7 + α ^ 6 := by simpa using α_recurrence 6
    _ = 21 * α + 13 := by nlinarith [α_pow_seven, α_pow_six]

theorem β_pow_seven : β ^ 7 = 13 * β + 8 := by
  calc
    β ^ 7 = β ^ 6 + β ^ 5 := by simpa using β_recurrence 5
    _ = 13 * β + 8 := by nlinarith [β_pow_six, β_pow_five]

theorem α_pow_nine : α ^ 9 = 34 * α + 21 := by
  calc
    α ^ 9 = α ^ 8 + α ^ 7 := by simpa using α_recurrence 7
    _ = 34 * α + 21 := by nlinarith [α_pow_eight, α_pow_seven]

theorem α_pow_ten : α ^ 10 = 55 * α + 34 := by
  calc
    α ^ 10 = α ^ 9 + α ^ 8 := by simpa using α_recurrence 8
    _ = 55 * α + 34 := by nlinarith [α_pow_nine, α_pow_eight]

theorem β_pow_eight : β ^ 8 = 21 * β + 13 := by
  calc
    β ^ 8 = β ^ 7 + β ^ 6 := by simpa using β_recurrence 6
    _ = 21 * β + 13 := by nlinarith [β_pow_seven, β_pow_six]

/-- `G_n(q) := ∏_{k=1}^N 1/((1 - q^{5k-4})(1 - q^{5k-1}))`, finite. -/
noncomputable def G_trunc (q : ℂ) (N : Nat) : ℂ :=
  match N with
  | 0 => 1
  | Nat.succ n =>
      G_trunc q n / ((1 - q ^ (5 * (n + 1) - 4)) * (1 - q ^ (5 * (n + 1) - 1)))

/-- `H_n(q) := ∏_{k=1}^N 1/((1 - q^{5k-3})(1 - q^{5k-2}))`, finite. -/
noncomputable def H_trunc (q : ℂ) (N : Nat) : ℂ :=
  match N with
  | 0 => 1
  | Nat.succ n =>
      H_trunc q n / ((1 - q ^ (5 * (n + 1) - 3)) * (1 - q ^ (5 * (n + 1) - 2)))

/-- N=0 sanity for `G_trunc`. -/
theorem G_trunc_zero (q : ℂ) : G_trunc q 0 = 1 := rfl

/-- Recursion wrapper for `G_trunc`. -/
theorem G_trunc_succ (q : ℂ) (n : Nat) :
    G_trunc q (n + 1) =
      G_trunc q n / ((1 - q ^ (5 * (n + 1) - 4)) * (1 - q ^ (5 * (n + 1) - 1))) := rfl

/-- Recursion wrapper for `H_trunc`. -/
theorem H_trunc_succ (q : ℂ) (n : Nat) :
    H_trunc q (n + 1) =
      H_trunc q n / ((1 - q ^ (5 * (n + 1) - 3)) * (1 - q ^ (5 * (n + 1) - 2))) := rfl

/-- N=1 sanity for `G_trunc`. -/
theorem G_trunc_one (q : ℂ) :
    G_trunc q 1 = 1 / ((1 - q ^ 4) * (1 - q)) := by
  simp [G_trunc, div_eq_mul_inv, mul_comm]

/-- N=0 sanity for `H_trunc`. -/
theorem H_trunc_zero (q : ℂ) : H_trunc q 0 = 1 := rfl

/-- N=1 sanity for `H_trunc`. -/
theorem H_trunc_one (q : ℂ) :
    H_trunc q 1 = 1 / ((1 - q ^ 2) * (1 - q ^ 3)) := by
  simp [H_trunc, div_eq_mul_inv, mul_comm]

theorem G_trunc_two (q : ℂ) :
    G_trunc q 2 = 1 / ((1 - q ^ 4) * (1 - q) * (1 - q ^ 9) * (1 - q ^ 6)) := by
  simp [G_trunc]
  field_simp

theorem H_trunc_two (q : ℂ) :
    H_trunc q 2 = 1 / ((1 - q ^ 2) * (1 - q ^ 3) * (1 - q ^ 7) * (1 - q ^ 8)) := by
  simp [H_trunc]
  field_simp

theorem G_trunc_three (q : ℂ) :
    G_trunc q 3 = G_trunc q 2 * (1 / ((1 - q ^ 11) * (1 - q ^ 14))) := by
  simp [G_trunc]
  field_simp

theorem H_trunc_three (q : ℂ) :
    H_trunc q 3 = H_trunc q 2 * (1 / ((1 - q ^ 12) * (1 - q ^ 13))) := by
  simp [H_trunc]
  field_simp

/-- Finite Rogers-Ramanujan continued fraction `R_trunc q N`.
At N=0: 1 (empty fraction). At N+1: 1 / (1 + q^(N+1) · R_trunc q N).
This builds the fraction "from the inside out". -/
noncomputable def R_trunc (q : ℂ) : Nat → ℂ
  | 0 => 1
  | Nat.succ n => 1 / (1 + q ^ (n + 1) * R_trunc q n)

theorem R_trunc_zero (q : ℂ) : R_trunc q 0 = 1 := rfl

theorem R_trunc_one (q : ℂ) : R_trunc q 1 = 1 / (1 + q) := by
  simp [R_trunc]

theorem R_trunc_two (q : ℂ) : R_trunc q 2 = 1 / (1 + q ^ 2 / (1 + q)) := by
  simp [R_trunc]
  field_simp

theorem R_trunc_three (q : ℂ) :
    R_trunc q 3 = 1 / (1 + q ^ 3 / (1 + q ^ 2 / (1 + q))) := by
  simp [R_trunc]
  field_simp

theorem R_trunc_four (q : ℂ) :
    R_trunc q 4 = 1 / (1 + q ^ 4 / (1 + q ^ 3 / (1 + q ^ 2 / (1 + q)))) := by
  simp [R_trunc]
  field_simp

theorem G_trunc_four (q : ℂ) :
    G_trunc q 4 = G_trunc q 3 * (1 / ((1 - q ^ 16) * (1 - q ^ 19))) := by
  simp [G_trunc]
  field_simp

theorem H_trunc_four (q : ℂ) :
    H_trunc q 4 = H_trunc q 3 * (1 / ((1 - q ^ 17) * (1 - q ^ 18))) := by
  simp [H_trunc]
  field_simp

theorem G_trunc_five (q : ℂ) :
