  show G_trunc q 4 / ((1 - q ^ (5 * (4 + 1) - 4)) * (1 - q ^ (5 * (4 + 1) - 1))) =
       G_trunc q 4 / ((1 - q ^ 21) * (1 - q ^ 24))
  norm_num

